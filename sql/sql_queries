-- INSERT INTO fato_vendas (vendedor_id, produto_id, data_id, valor_venda)
-- SELECT 
--     dv.vendedor_id,
--     dp.produto_id,
--     v.data_venda,
--     v.valor_venda
-- FROM vendas v
-- JOIN dim_vendedor dv ON v.vendedor = dv.nome
-- JOIN dim_produto dp ON v.produto = dp.nome_produto AND v.categoria = dp.categoria;

SELECT
    dv.nome AS vendedor,
    dp.nome_produto AS produto,
    dp.categoria,
    dt.nome_mes,
    dt.trimestre,
    f.valor_venda
FROM fato_vendas f
JOIN dim_vendedor dv ON f.vendedor_id = dv.vendedor_id
JOIN dim_produto dp ON f.produto_id = dp.produto_id
JOIN dim_tempo dt ON f.data_id = dt.data_id
ORDER BY dv.nome, dt.data_id;
